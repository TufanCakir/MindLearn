[
    {
        "id": "html_001",
        "title": {
            "de": "Button erstellen",
            "en": "Create button"
        },
        "description": {
            "de":
                "Lerne, wie du in HTML einen einfachen klickbaren Button erstellst.",
            "en": "Learn how to create a simple clickable button in HTML."
        },
        "steps": [
            {
                "de": "Erstelle das Grundgerüst mit <!DOCTYPE html>.",
                "en": "Create the base structure with <!DOCTYPE html>."
            },
            {
                "de": "Füge <button> innerhalb des <body>-Tags hinzu.",
                "en": "Add <button> inside the <body> tag."
            },
            {
                "de": "Füge optional CSS hinzu, um den Button zu stylen.",
                "en": "Optionally add CSS to style the button."
            }
        ],
        "colors": {
            "backgroundColors": [
                "#000000",
                "#7209B7",
                "#000000"
            ],
            "textColors": [
                "#FFFFFF"
            ]
        },
        "code":
            "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Button Beispiel</title>\n</head>\n<body>\n    <button>Click me</button>\n</body>\n</html>",
        "category": "HTML"
    },
    {
